{
  "name": "task-management-app",
  "version": "1.0.0",
  "description": "Full Stack Task Management Application",
  "main": "backend/server.js",
  "scripts": {
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install --include=dev",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run install:backend && npm run install:frontend && npm run build:frontend",
    "start": "node backend/server.js",
    "test": "node tests/verifyTaskApp.js",
    "backend": "npm --prefix backend start",
    "frontend": "npm --prefix frontend run dev"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "task-management",
    "react",
    "express",
    "mongodb",
    "jwt",
    "tailwindcss"
  ],
  "author": "",
  "license": "ISC"
}
