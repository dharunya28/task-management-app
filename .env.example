# ==============================================================
# TASK MANAGEMENT APP - ENVIRONMENT TEMPLATE
# Copy to backend/.env for local development
# Set these variables in Render Dashboard under 'Environment'
# ==============================================================

# Port the Express server listens on (Render automatically provides PORT in production)
PORT=5000

# MongoDB Atlas Connection String
# Format: mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/task_manager_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/task_manager_db?retryWrites=true&w=majority

# JWT Secret Key (Use a strong random string in production)
JWT_SECRET=your_super_secret_jwt_token_key_here
